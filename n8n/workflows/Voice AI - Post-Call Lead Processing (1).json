        "responses": {
          "values": [
            {
              "content": "=Caller ID (from telephony, for reference only): {{ $(\"Prepare Call Data\").item.json.phone_number || \"unknown\" }}\n\nCall transcript:\n\"\"\"\n{{ $(\"Prepare Call Data\").item.json.transcript }}\n\"\"\""
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "You extract real-estate sales lead information from a phone call transcript between an AI sales agent and a customer.\nRules:\n- Use ONLY information explicitly stated by the CUSTOMER in the transcript. Never guess, infer, or invent values.\n- If a field was not clearly provided, return null for it.\n- name: the customer's own name as they stated it (not the agent's name). null if not stated.\n- phone: a phone number the customer explicitly spoke in the call, digits only with country code if stated. null if none was spoken (the caller ID is handled separately).\n- budget_text: the exact budget phrase the customer used (e.g. \"around 60 lakh\"). null if no budget was mentioned.\n- budget: that budget converted to a whole number of Indian Rupees (1 lakh = 100000, 1 crore = 10000000). If the customer gave a range, use the upper limit. null if no budget was mentioned.\n- preferred_location: the city/area the customer wants to buy in. null if not stated.\n- property_type: a short description of the property they want, combining configuration and type when stated (e.g. \"2 BHK apartment\", \"3 BHK villa\", \"plot\"). Only add \"apartment\" when they said flat/apartment or only a BHK count. null if not stated.",
          "maxTokens": 2000,
          "reasoning": {
            "reasoningOptions": {
              "effort": "low",
              "summary": "none"
            }
          },
          "store": false,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "lead_extraction",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"name\",\"phone\",\"budget\",\"budget_text\",\"preferred_location\",\"property_type\"],\"properties\":{\"name\":{\"type\":[\"string\",\"null\"],\"description\":\"Customer name as stated, or null\"},\"phone\":{\"type\":[\"string\",\"null\"],\"description\":\"Phone number spoken by the customer, or null\"},\"budget\":{\"type\":[\"integer\",\"null\"],\"description\":\"Budget in INR as a whole number, or null\"},\"budget_text\":{\"type\":[\"string\",\"null\"],\"description\":\"Verbatim budget phrase, or null\"},\"preferred_location\":{\"type\":[\"string\",\"null\"],\"description\":\"Preferred city/area, or null\"},\"property_type\":{\"type\":[\"string\",\"null\"],\"description\":\"Desired property type, or null\"}}}",
              "description": "Structured lead details extracted from a sales call transcript",
              "strict": true
            }
          }
        }
      },
