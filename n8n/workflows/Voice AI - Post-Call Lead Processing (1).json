    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst call = $('Prepare Call Data').item.json;\nconst errors = [];\nconst warnings = [];\n\n// 1. Read the model output (structured output is normally already an object)\nlet raw = null;\ntry {\n  raw = $json.output[0].content[0].text;\n} catch (e) {\n  raw = null;\n}\nlet parsed = raw;\nif (typeof raw === 'string') {\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    parsed = null;\n    errors.push('LLM output is not valid JSON');\n  }\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  if (errors.length === 0) errors.push('LLM output missing or not a JSON object');\n  parsed = null;\n}\nconst p = parsed || {};\nconst REQUIRED_KEYS = ['name', 'phone', 'budget', 'budget_text', 'preferred_location', 'property_type'];\nif (parsed) {\n  const missingKeys = REQUIRED_KEYS.filter((k) => !(k in parsed));\n  if (missingKeys.length > 0) {\n    errors.push('LLM output does not match lead schema (missing keys: ' + missingKeys.join(', ') + ')');\n  }\n}\n\n// 2. Helpers\nconst EMPTY = ['null', 'none', 'n/a', 'na', 'unknown', 'not provided', 'not mentioned', 'not stated', '-'];\nfunction cleanText(v, maxLen) {\n  if (v === null || v === undefined) return null;\n  const s = String(v).replace(/\\s+/g, ' ').trim();\n  if (!s) return null;\n  if (EMPTY.includes(s.toLowerCase())) return null;\n  return s.slice(0, maxLen || 200);\n}\nfunction normalizePhone(v) {\n  if (v === null || v === undefined) return null;\n  const str = String(v).trim();\n  if (!str) return null;\n  const hasPlus = str.startsWith('+');\n  const d = str.replace(/\\D/g, '');\n  if (!d) return null;\n  if (d.length === 10 && /^[6-9]/.test(d)) return '+91' + d;\n  if (d.length === 11 && d.startsWith('0')) return '+91' + d.slice(1);\n  if (d.length === 12 && d.startsWith('91')) return '+' + d;\n  if (hasPlus && d.length >= 8 && d.length <= 15) return '+' + d;\n  return null;\n}\nfunction parseBudget(v, text) {\n  if (typeof v === 'number' && Number.isFinite(v) && v > 0) return Math.round(v);\n  const src = (v !== null && v !== undefined && v !== '') ? String(v) : (text || '');\n  const s = src.toLowerCase().replace(/,/g, '');\n  const m = s.match(/(\\d+(?:\\.\\d+)?)/);\n  if (!m) return null;\n  let n = parseFloat(m[1]);\n  if (/crore|\\bcr\\b/.test(s)) n = n * 10000000;\n  else if (/lakh|lac|\\bl\\b/.test(s)) n = n * 100000;\n  else if (/million/.test(s)) n = n * 1000000;\n  else if (/thousand|\\bk\\b/.test(s)) n = n * 1000;\n  return n > 0 ? Math.round(n) : null;\n}\n\n// 3. Normalize fields\nconst name = cleanText(p.name, 120);\nconst preferred_location = cleanText(p.preferred_location, 120);\nconst property_type = cleanText(p.property_type, 120);\nconst budget_text = cleanText(p.budget_text, 120);\n\nlet budget = parsed ? parseBudget(p.budget, budget_text) : null;\nif (budget !== null && (budget < 100000 || budget > 10000000000)) {\n  warnings.push('budget ' + budget + ' outside plausible range (1 lakh to 1000 crore), set to null');\n  budget = null;\n}\n\n// Caller ID from telephony is authoritative; fall back to a number spoken in the call\nconst callerPhone = normalizePhone(call.phone_number);\nconst spokenPhone = normalizePhone(p.phone);\nlet phone = null;\nlet phone_source = null;\nif (callerPhone) { phone = callerPhone; phone_source = 'caller_id'; }\nelse if (spokenPhone) { phone = spokenPhone; phone_source = 'transcript'; }\nif (callerPhone && spokenPhone && callerPhone !== spokenPhone) {\n  warnings.push('customer spoke a different number (' + spokenPhone + ') than caller ID');\n}\nif (!phone) errors.push('no valid phone number (caller ID missing/invalid and none spoken)');\nif (!name) warnings.push('customer name not provided');\n\nreturn {\n  json: {\n    call_id: call.call_id,\n    lead: { name, phone, budget, preferred_location, property_type },\n    extraction: {\n      is_valid: errors.length === 0,\n      can_create_new_lead: errors.length === 0 && name !== null,\n      errors,\n      warnings,\n      phone_source,\n      alternate_phone: (spokenPhone && spokenPhone !== phone) ? spokenPhone : null,\n      budget_text,\n      llm_raw: parsed,\n      extracted_at: new Date().toISOString(),\n    },\n    call: {\n      phone_number: call.phone_number || null,\n      started_at: call.started_at || null,\n      ended_at: call.ended_at || null,\n      duration_seconds: call.duration_seconds ?? null,\n      transcript: call.transcript,\n    },\n  },\n};\n"
      },
