    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Lead Ready for Storage').first().json;\nconst lead = ctx.lead;\nconst isEmpty = (v) => v === null || v === undefined || (typeof v === 'string' && v.trim() === '');\n\n// Rows returned by the lookup (an empty result arrives as one empty item)\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r && r.id !== undefined && r.id !== null)\n  .sort((a, b) => Number(a.id) - Number(b.id));\n\nconst warnings = [...(ctx.extraction.warnings || [])];\nconst FILLABLE = ['name', 'budget', 'preferred_location', 'property_type'];\nlet action;\nlet reason = null;\nlet existing = null;\nconst patch = {};\nlet newRow = null;\n\nif (rows.length > 0) {\n  existing = rows[0];\n  if (rows.length > 1) {\n    warnings.push(rows.length + ' existing leads share this phone (ids ' + rows.map((r) => r.id).join(', ') + '); using oldest id ' + existing.id);\n  }\n  for (const f of FILLABLE) {\n    if (isEmpty(existing[f]) && !isEmpty(lead[f])) patch[f] = lead[f];\n  }\n  action = Object.keys(patch).length > 0 ? 'update_existing' : 'existing_unchanged';\n} else if (!isEmpty(lead.name) && !isEmpty(lead.phone)) {\n  action = 'create_new';\n  newRow = { name: lead.name, phone: lead.phone };\n  if (!isEmpty(lead.budget)) newRow.budget = lead.budget;\n  if (!isEmpty(lead.preferred_location)) newRow.preferred_location = lead.preferred_location;\n  if (!isEmpty(lead.property_type)) newRow.property_type = lead.property_type;\n} else {\n  action = 'not_created';\n  reason = isEmpty(lead.name)\n    ? 'Customer name was not provided in the call and no existing lead matches phone ' + lead.phone + '; a lead requires a real name, so none was created'\n    : 'No valid phone number available; a lead requires a phone number';\n}\n\nreturn [{\n  json: {\n    call_id: ctx.call_id,\n    action,\n    reason,\n    existing_lead_id: existing ? existing.id : null,\n    existing_lead: existing,\n    patch,\n    new_row: newRow,\n    lead,\n    extraction: ctx.extraction,\n    call: ctx.call,\n    warnings,\n  },\n}];\n"
      },
